{
  "extends": [
    "config:base",
    ":rebaseStalePrs",
    ":semanticCommits"
  ],
  "assignees": [
    "gciatto"
  ],
  "automerge": true,
  "dependencyDashboard": true,
  "includeForks": true,
  "packageRules": [
    {
      "description": "Updates to GitHub Actions should be tagged as 'ci'",
      "matchPaths": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml"
      ],
      "semanticCommitType": "ci"
    },
    {
      "description": "JPype1 1.7.1 has no wheels for Python 3.15 yet: raise when it does",
      "matchFileNames": ["csv-python/.python-version"],
      "allowedVersions": "<3.15"
    },
    {
      "matchPackageNames": ["net.sourceforge.plantuml:plantuml"],
      "allowedVersions": "/^1\\./"
    }
  ],
  "prConcurrentLimit": 25,
  "prHourlyLimit": 0,
  "separateMajorMinor": true,
  "separateMinorPatch": true,
  "separateMultipleMajor": true
}
